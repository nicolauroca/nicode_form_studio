<?xml version="1.0" encoding="UTF-8"?>
<extension type="module" client="site" method="upgrade">
  <name>mod_nicode_form_studio</name>
  <version>1.0.4</version>
  <author>Nicode</author>
  <creationDate>2026-09</creationDate>
  <license>GPL-2.0-or-later</license>
  <description>MOD_NICODE_FORM_STUDIO_DESCRIPTION</description>
  <namespace path="src">Nicode\Module\FormStudio</namespace>
  <files><folder module="mod_nicode_form_studio">services</folder><folder>src</folder><folder>tmpl</folder></files>
  <languages folder="language">
    <language tag="en-GB">en-GB/mod_nicode_form_studio.ini</language><language tag="es-ES">es-ES/mod_nicode_form_studio.ini</language>
    <language tag="en-GB">en-GB/mod_nicode_form_studio.sys.ini</language><language tag="es-ES">es-ES/mod_nicode_form_studio.sys.ini</language>
  </languages>
  <config><fields name="params"><fieldset name="basic" addfieldprefix="Nicode\Component\FormStudio\Administrator\Field">
    <field name="form_id" type="formstudio" label="MOD_NICODE_FORM_STUDIO_SELECT_FORM" description="MOD_NICODE_FORM_STUDIO_SELECT_FORM_HELP" filter="integer" required="true" />
    <field name="show_form_title" type="radio" layout="joomla.form.field.radio.switcher" label="MOD_NICODE_FORM_STUDIO_SHOW_FORM_TITLE" default="0" filter="integer"><option value="0">JNO</option><option value="1">JYES</option></field>
    <field name="show_description" type="radio" layout="joomla.form.field.radio.switcher" label="MOD_NICODE_FORM_STUDIO_SHOW_DESCRIPTION" default="0" filter="integer"><option value="0">JNO</option><option value="1">JYES</option></field>
    <field name="form_class" type="text" label="MOD_NICODE_FORM_STUDIO_FORM_CLASS" description="MOD_NICODE_FORM_STUDIO_FORM_CLASS_HELP" filter="string" maxlength="650" />
    <field name="unavailable_mode" type="list" label="MOD_NICODE_FORM_STUDIO_UNAVAILABLE_MODE" default="hide" filter="cmd"><option value="hide">MOD_NICODE_FORM_STUDIO_UNAVAILABLE_HIDE</option><option value="message">MOD_NICODE_FORM_STUDIO_UNAVAILABLE_MESSAGE</option></field>
    <field name="layout" type="modulelayout" label="JFIELD_ALT_LAYOUT_LABEL" class="form-select" validate="moduleLayout" />
    <field name="cache" type="hidden" default="0" filter="integer" />
  </fieldset></fields></config>
</extension>
